{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/me", "destination": "/api/health?route=me" },
    { "source": "/api/csrf", "destination": "/api/health?route=csrf" },
    { "source": "/api/logout", "destination": "/api/health?route=logout" },
    { "source": "/api/guilds/:guildId/diagnostics", "destination": "/api/health?route=diagnostics&guildId=:guildId" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" }
      ]
    }
  ]
}
